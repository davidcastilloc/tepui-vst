{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tepui-ai-synth-gateway",
  "account_id": "aedd0159259bcb5220041dfe0f088976",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "TEPUI_KV",
      "id": "ee612ebbc37e43ea9ae6f79077cc32c2"
    }
  ]
}
