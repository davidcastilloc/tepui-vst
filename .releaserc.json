{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "type": "feat", "release": "minor" },
          { "type": "fix", "release": "patch" },
          { "type": "perf", "release": "patch" },
          { "type": "revert", "release": "patch" },
          { "breaking": true, "release": "major" }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "Nuevas Funcionalidades (Features)" },
            { "type": "fix", "section": "Correcciones de Errores (Bug Fixes)" },
            { "type": "perf", "section": "Optimizaciones DSP y Rendimiento" },
            { "type": "refactor", "section": "Refactorizaciones Internas", "hidden": false },
            { "type": "docs", "section": "Documentación", "hidden": false },
            { "type": "test", "section": "Pruebas Automatizadas", "hidden": true },
            { "type": "ci", "section": "CI/CD y Automatización", "hidden": true },
            { "type": "chore", "section": "Mantenimiento", "hidden": true }
          ]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog\n\nTodos los cambios notables en **TEPUI // Gran Sabana Sonic Lab** se documentan automáticamente en este archivo siguiendo [Conventional Commits](https://www.conventionalcommits.org/) y [Semantic Versioning](https://semver.org/)."
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "cargo run --package xtask -- set-version ${nextRelease.version} && cargo build --release -p plugin_vst --bins && cargo run --package xtask -- bundle plugin_vst --release && powershell -NoProfile -Command \"Compress-Archive -Path target/bundled/TEPUI.vst3,target/bundled/TEPUI.clap,target/release/tepui_studio.exe,README.md,LICENSE,CHANGELOG.md -DestinationPath target/bundled/TEPUI-GranSabana-Windows-x64.zip -Force\""
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "Cargo.toml",
          "Cargo.lock",
          "crates/synth_core/Cargo.toml",
          "crates/ai_bridge/Cargo.toml",
          "crates/plugin_vst/Cargo.toml",
          "crates/xtask/Cargo.toml"
        ],
        "message": "chore(release): v${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "target/bundled/TEPUI-GranSabana-Windows-x64.zip",
            "label": "TEPUI VST3 + CLAP + Standalone Studio (Windows x64 ZIP)"
          },
          {
            "path": "target/bundled/TEPUI.clap",
            "label": "TEPUI.clap (Windows x64 CLAP Plugin)"
          },
          {
            "path": "target/release/tepui_studio.exe",
            "label": "tepui_studio.exe (Windows x64 Standalone Workstation)"
          }
        ]
      }
    ]
  ]
}
