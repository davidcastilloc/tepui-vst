{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tepui-vst",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "site",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "TEPUI_CREDITS_KV",
      "id": "ee612ebbc37e43ea9ae6f79077cc32c2"
    }
  ]
}
